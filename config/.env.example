# ISPSemanticWise Configuration
# Copy to config/.env and fill in values

# ==========================================
# NVIDIA API (for Tier 2 models)
# ==========================================
NVIDIA_API_KEY=your_nvidia_api_key_here

# ==========================================
# Vector Database (ChromaDB)
# ==========================================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=isp_semantic_chunks

# ==========================================
# Graph Database (Neo4j)
# ==========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ==========================================
# Relational Database (PostgreSQL)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=isp_semantic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ==========================================
# Model Routing
# ==========================================
TIER1_MODEL=meta/llama-3.2-11b-vision-instruct
TIER1_PROVIDER=nvidia
TIER1_MAX_TOKENS=2000
TIER1_TEMPERATURE=0.1

TIER2_MODEL=nvidia/nemotron-3-super-120b-a12b
TIER2_PROVIDER=nvidia
TIER2_MAX_TOKENS=4000
TIER2_TEMPERATURE=0.3

# ==========================================
# Ab Initio Configuration
# ==========================================
AB_INITIO_GRAPH_PATH=/data/ab_initio/graphs
AB_INITIO_XFR_PATH=/data/ab_initio/xfrs
AB_INITIO_DML_PATH=/data/ab_initio/dmls

# ==========================================
# Oracle Configuration
# ==========================================
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCL
ORACLE_USER=schema_user
ORACLE_PASSWORD=password
ORACLE_SCHEMA=POST_TRADE

# ==========================================
# Unix Scripts Path
# ==========================================
UNIX_SCRIPTS_PATH=/data/scripts

# ==========================================
# Email / Jira Configuration
# ==========================================
JIRA_URL=https://your-company.atlassian.net
JIRA_USER=your-email@company.com
JIRA_API_TOKEN=your_jira_token
JIRA_PROJECT_KEY=PTM

CONFLUENCE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_USER=your-email@company.com
CONFLUENCE_API_TOKEN=your_confluence_token

# ==========================================
# Application Settings
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# ==========================================
# Security
# ==========================================
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ==========================================
# Feature Flags
# ==========================================
ENABLE_TIER2=true
ENABLE_EMAIL_INGESTION=false
ENABLE_JIRA_INGESTION=false
ENABLE_UI=false